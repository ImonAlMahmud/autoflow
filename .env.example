APP_NAME="Autoflow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=autoflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=autoflow_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@autoflow.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Configuration
AI_DEFAULT_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120
AI_TIMEOUT=120
AI_DEFAULT_TEMPERATURE=0.7

# Git Configuration
GIT_TIMEOUT=60
GIT_EXECUTABLE=git

# Workspace Configuration
WORKSPACE_ROOT=/opt/ai-content-refresh/workspaces
WORKSPACE_MAX_AGE_HOURS=24

# Content Rewrite Defaults
DEFAULT_REWRITE_INTERVAL=30
REWRITE_MAX_EXPANSION_PERCENT=30
REWRITE_MAX_REDUCTION_PERCENT=25

# Queue Configuration
QUEUE_RETRY_AFTER=90
QUEUE_MAX_TRIES=3
